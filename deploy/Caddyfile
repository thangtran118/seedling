# TLS reverse proxy for the app. Caddy gets and renews the Let's Encrypt certificate on its own; it needs ports
# 80 and 443 open and SITE_DOMAIN's DNS pointing at this server. HTTP is redirected to HTTPS automatically.
# Caddy replaces any X-Forwarded-For sent by the client, so the app's login rate limit sees the real IP.
{$SITE_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy app:3000
}
